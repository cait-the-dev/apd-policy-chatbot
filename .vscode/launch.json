{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "apd_policy_chatbot.api:app",
        "--host", "127.0.0.1",
        "--port", "8000",
        "--reload",              
        "--reload-dir", "${workspaceFolder}/apd_policy_chatbot"
      ],
      "jinja": true,            
      "envFile": "${workspaceFolder}/.env",    
      "console": "integratedTerminal",
      "justMyCode": false    
    },
    {
      "name": "Pytest (single file)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-vv", "${file}"],
      "console": "integratedTerminal"
    },
    {
      "name": "Pytest (focused test)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-vv",
        "tests/test_api.py::test_ingest_then_healthz_true_and_ask"
      ],
      "console": "integratedTerminal"
    }
  ]
}
